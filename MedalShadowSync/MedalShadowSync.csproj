<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>reMedal</AssemblyName>
    <RootNamespace>MedalShadowSync</RootNamespace>
    <Version>1.3.0</Version>
    <Product>reMedal</Product>
    <Description>Automatic ShadowPlay to Medal.tv clip importer &amp; Throwbacks patcher</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\games.json.gz" />
    <EmbeddedResource Include="Resources\throwbacks_inject.js" />
  </ItemGroup>

</Project>
